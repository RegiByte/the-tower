{
  "id": "pulse",
  "version": "1.0",
  "title": "Pulse",
  "description": "Logs a line at its interval while it runs, pings through chime, reads its beat, and keeps its beats: the fixture the server test boots.",
  "requires": { "tower": "1.83", "chime": "1.0" },
  "server": "server.ts",
  "settings": {
    "type": "object",
    "additionalProperties": false,
    "properties": { "every": { "type": "integer", "minimum": 1000, "default": 60000 }, "line": { "type": "string" } }
  },
  "verbs": {
    "ping": {
      "input": {
        "type": "object",
        "required": ["project"],
        "properties": { "project": { "type": "string" }, "times": { "type": "integer", "minimum": 1 } }
      },
      "reply": {
        "type": "object",
        "required": ["project", "chimed"],
        "properties": { "project": { "type": "string" }, "chimed": { "type": "object" } }
      },
      "scope": "project",
      "words": { "label": "Ping", "hint": "rings chime for the floor" }
    },
    "pong": {
      "input": { "type": "object" },
      "reply": { "type": "object", "required": ["pong"], "properties": { "pong": { "const": true } } },
      "scope": "system",
      "deprecated": { "since": "1.0", "use": "pulse/ping", "why": "a ping names its floor" }
    },
    "beat": {
      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": ["project"],
        "properties": { "project": { "type": "string" }, "session": { "type": "string" } }
      },
      "reply": { "type": "object", "required": ["item"], "properties": { "item": { "type": "string" } } },
      "scope": "project",
      "words": { "label": "Beat", "hint": "keeps a beat on the floor, and as a fact of the session when one is named" }
    }
  },
  "reads": {
    "beats/<project>": {
      "reply": {
        "type": "object",
        "required": ["project", "every"],
        "properties": { "project": { "type": "string" }, "every": { "type": "integer" } }
      },
      "scope": "project",
      "description": "How often it beats on the floor."
    },
    "kept/<project>": {
      "query": { "type": "object", "additionalProperties": false, "properties": { "session": { "type": "string" } } },
      "reply": {
        "type": "object",
        "required": ["beats", "items", "facts"],
        "properties": { "beats": { "type": "object" }, "items": { "type": "array" }, "facts": { "type": "array" } }
      },
      "scope": "project",
      "description": "What it keeps on the floor as the tower folds it: its beats stream reduced, its items parsed, and a session's beat facts."
    }
  },
  "collections": {
    "pulse": {
      "label": "Beats",
      "description": "One file per beat, written only by pulse.",
      "owned": true,
      "doors": {
        "list": "pulse/kept/<project>",
        "read": "tower/collection/<project>/<collection>/<item>",
        "create": "pulse/beat",
        "edit": { "none": "A beat is never rewritten." },
        "delete": { "none": "Beats are kept." }
      }
    }
  },
  "streams": {
    "beats": {
      "scope": "project",
      "description": "Each beat, as it was kept.",
      "facts": { "b": { "schema": { "type": "object", "additionalProperties": false, "required": ["item"], "properties": { "item": { "type": "string" } } } } }
    }
  },
  "facts": {
    "beat": { "description": "A beat a session took.", "schema": { "type": "integer", "minimum": 1 } }
  }
}
