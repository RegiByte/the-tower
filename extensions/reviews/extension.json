{
  "id": "reviews",
  "version": "1.0",
  "title": "Review threads",
  "description": "One markdown thread of notes per checkout, where the user, the workers in it and its reviewers talk about its unlanded work.",
  "requires": {
    "tower": "1.111"
  },
  "server": "server.ts",
  "client": "client",
  "collections": {
    "reviews": {
      "label": "Reviews",
      "description": "One review thread per checkout, written only with `tower note`: not a place for write-ups.",
      "owned": true,
      "doors": {
        "list": "reviews/history/<project>",
        "read": "tower/collection/<project>/<collection>/<item>",
        "create": "reviews/append",
        "edit": "reviews/resolve",
        "delete": {
          "none": "a thread is filed by Tidy once its work lands, never deleted"
        }
      }
    }
  },
  "facts": {
    "of": {
      "description": "The callsign whose work this session reviews.",
      "schema": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9]*-\\d+$"
      }
    }
  },
  "spawn": {
    "launch": true,
    "fields": {
      "of": {
        "schema": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*-\\d+$"
        },
        "words": {
          "label": "Reviews",
          "hint": "The worker whose work this one reviews"
        },
        "form": false
      }
    }
  },
  "views": {
    "thread": {
      "module": "thread.js",
      "export": "mount",
      "on": ["card"],
      "scales": ["pane"],
      "needs": ["display", "toast"],
      "tab": "tab",
      "words": {
        "label": "Reviews",
        "hint": "the review thread of the worker's checkout: notes from you, its workers and reviewers"
      }
    }
  },
  "subjects": {
    "thread": {
      "description": "A checkout's review thread, keyed by its checkout.",
      "in": "floor",
      "list": "threads"
    }
  },
  "folds": {
    "card": {
      "x": {
        "type": "object",
        "required": [
          "thread",
          "threadState"
        ],
        "properties": {
          "thread": {
            "type": "string",
            "description": "The checkout its review thread is about: a reviewer's is its author's."
          },
          "threadState": {
            "type": "object",
            "required": [
              "is"
            ],
            "properties": {
              "is": {
                "enum": [
                  "live",
                  "landed",
                  "gone"
                ]
              }
            },
            "description": "Where the work its thread is about stands, with the thread Tidy filed once it landed."
          },
          "unseen": {
            "type": "integer",
            "minimum": 0,
            "description": "The notes on its thread it hasn't seen (after its own last one), while its thread's work is live."
          },
          "filed": {
            "type": "object",
            "required": [
              "id",
              "tag",
              "at"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "tag": {
                "type": "string"
              },
              "at": {
                "type": "string"
              }
            },
            "description": "The thread Tidy filed once the work in its own checkout landed."
          },
          "of": {
            "type": "string",
            "description": "The callsign of the worker whose work this one reviews."
          },
          "note": {
            "type": "array",
            "prefixItems": [
              {
                "const": "reviews/append"
              },
              {
                "type": "object",
                "required": [
                  "project",
                  "checkout"
                ]
              }
            ],
            "minItems": 2,
            "maxItems": 2,
            "description": "The call that adds a note to its thread while that work is live: the renderer adds the author and what the note says."
          }
        }
      },
      "adds": [
        "actions"
      ]
    },
    "floor": {
      "x": {
        "type": "object",
        "required": [
          "threads"
        ],
        "properties": {
          "threads": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "key",
                "checkout",
                "id",
                "tag",
                "messages",
                "landed",
                "state",
                "verbs",
                "calls",
                "actions",
                "resolved"
              ],
              "properties": {
                "key": {
                  "type": "string",
                  "description": "<project>/<checkout>: its subject is reviews.thread:floor:<project>/<project>/<checkout>."
                },
                "checkout": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "tag": {
                  "type": "string"
                },
                "messages": {
                  "type": "integer",
                  "minimum": 0
                },
                "landed": {
                  "type": "boolean"
                },
                "state": {
                  "type": "object",
                  "required": [
                    "is"
                  ]
                },
                "resolved": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                  },
                  "description": "Its resolved notes, by number, in order."
                }
              }
            }
          }
        }
      },
      "adds": [
        "tidy"
      ]
    }
  },
  "verbs": {
    "append": {
      "scope": "project",
      "input": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "minLength": 1
          },
          "checkout": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$",
            "description": "A worktree's name, or `main` for the main checkouts."
          },
          "author": {
            "type": "string",
            "pattern": "^[^\\s\u00b7]([^\\n\u00b7]*[^\\s\u00b7])?$",
            "description": "Who writes: the user's name (`board.user.name`), or a worker's callsign."
          },
          "re": {
            "description": "The number of the message this one answers.",
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "anchors": {
            "default": [],
            "description": "The lines the note is about, each quoted as it was.",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "repo": {
                  "type": "string",
                  "pattern": "^[^`:\\s]+$",
                  "description": "The repo as the Changes pane names it: its main checkout's folder."
                },
                "path": {
                  "type": "string",
                  "pattern": "^[^`\\n]+$"
                },
                "from": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "to": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "quote": {
                  "type": "object",
                  "properties": {
                    "lang": {
                      "type": "string",
                      "pattern": "^\\S*$"
                    },
                    "lines": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[^\\n]*$"
                      }
                    }
                  },
                  "required": [
                    "lang",
                    "lines"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "repo",
                "path",
                "from",
                "to"
              ],
              "additionalProperties": false
            }
          },
          "body": {
            "type": "string"
          }
        },
        "required": [
          "project",
          "checkout",
          "author",
          "body"
        ],
        "additionalProperties": false
      },
      "reply": {
        "type": "object",
        "properties": {
          "t": {
            "type": "string",
            "const": "appended"
          },
          "id": {
            "type": "string"
          },
          "n": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "modifiedAt": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "t",
          "id",
          "n",
          "modifiedAt"
        ],
        "additionalProperties": false
      },
      "description": "Append a message to the checkout's review thread, made on the first one; it is numbered one past the last.",
      "words": {
        "label": "Note",
        "hint": "add a note to the checkout's review thread"
      }
    },
    "resolve": {
      "scope": "project",
      "input": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "minLength": 1
          },
          "checkout": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$",
            "description": "A worktree's name, or `main` for the main checkouts."
          },
          "author": {
            "type": "string",
            "pattern": "^[^\\s\u00b7]([^\\n\u00b7]*[^\\s\u00b7])?$",
            "description": "Who writes: the user's name (`board.user.name`), or a worker's callsign."
          },
          "notes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "description": "The notes it resolves, by number: each one of the thread's, unresolved and no resolution itself."
          },
          "body": {
            "type": "string",
            "description": "What the resolver adds under the mark."
          }
        },
        "required": [
          "project",
          "checkout",
          "author",
          "notes"
        ],
        "additionalProperties": false
      },
      "reply": {
        "type": "object",
        "properties": {
          "t": {
            "type": "string",
            "const": "appended"
          },
          "id": {
            "type": "string"
          },
          "n": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "modifiedAt": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "t",
          "id",
          "n",
          "modifiedAt"
        ],
        "additionalProperties": false
      },
      "description": "Mark notes of the checkout's thread resolved by appending a note, numbered like any other, whose body opens `**Resolved:** n3, n4`: append-only, and read as a plain note wherever resolving is unknown.",
      "words": {
        "label": "Resolve",
        "hint": "mark the note resolved on its thread"
      }
    },
    "hire": {
      "scope": "project",
      "input": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "minLength": 1
          },
          "of": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9]*-\\d+$",
            "description": "The callsign of the worker whose work is reviewed, on `project`."
          },
          "by": {
            "type": "string",
            "minLength": 1,
            "description": "The session hiring the reviewer: its hire is logged in its log, and never limited."
          },
          "tell": {
            "type": "boolean",
            "description": "The reviewer sends a pointer to its notes to the author when done."
          }
        },
        "required": [
          "project",
          "of"
        ],
        "additionalProperties": false
      },
      "reply": {
        "type": "object",
        "properties": {
          "t": {
            "type": "string",
            "const": "spawned"
          },
          "id": {
            "type": "string"
          },
          "cut": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "t",
          "id",
          "cut"
        ]
      },
      "description": "Hire a reviewer of a worker's unlanded work: a worker in a fork of its checkout, uncommitted work included, that reviews once against its goal and leaves notes on its thread. It sits beside its author, in its crew, and is exempt from hiring limits.",
      "words": {
        "label": "Review",
        "hint": "hire a reviewer in a fork of this worker's checkout"
      }
    }
  },
  "reads": {
    "history/<project>": {
      "scope": "project",
      "reply": {
        "type": "object",
        "required": [
          "threads",
          "authors"
        ],
        "properties": {
          "threads": {
            "type": "array"
          },
          "authors": {
            "type": "object"
          }
        }
      },
      "description": "The project's review threads, live and landed (filed by Tidy), oldest first, and what each author wrote in them."
    },
    "said/<project>": {
      "scope": "project",
      "description": "What `tower thread`, `tower note` and `tower send` say of a checkout's thread, read as `reader`: its file's text, the notes new to the reader, the lines printed after the text (or in its place while it has none), and with `sender`, the prompt Send types into the reader.",
      "query": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "checkout",
          "reader"
        ],
        "properties": {
          "checkout": {
            "type": "string",
            "description": "A worktree's name, or `main`."
          },
          "reader": {
            "type": "string",
            "description": "Whose view: a callsign, or the user's name."
          },
          "sender": {
            "type": "string",
            "description": "Who sends the notes to the reader: a callsign, or `the user`."
          },
          "hirer": {
            "type": "string",
            "description": "The callsign of the worker that hired the reader: Send tells it to report there."
          }
        }
      },
      "reply": {
        "type": "object",
        "required": [
          "unseen",
          "lines"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "unseen": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "send": {
            "type": "string"
          }
        }
      }
    }
  },
  "answers": {
    "tower/discard.done": {},
    "tower/discard.record": {},
    "tower/tidy.apply": {}
  }
}
