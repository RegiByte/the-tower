{
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "paths": {
      "tower:*": ["./src/shared/*"]
    }
  },
  "include": [
    "extensions",
    "scripts",
    "spikes",
    "src",
    "examples/extensions/*/*.ts",
    "test"
  ],
  "exclude": [
    "src/tower/client.d.ts"
  ]
}
