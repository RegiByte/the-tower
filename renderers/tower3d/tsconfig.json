{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2024", "dom", "dom.iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "paths": { "/lib/*.js": ["../../src/lib/*.ts"], "/x/drafts/*.js": ["../../extensions/drafts/client/*.ts"], "/x/quota/*.js": ["../../extensions/quota/client/*.ts"], "/x/reviews/*.js": ["../../extensions/reviews/client/*.ts"] }
  },
  "include": ["src"]
}
