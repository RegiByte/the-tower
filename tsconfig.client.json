{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2024", "dom", "dom.iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": true,
    "paths": { "/x/drafts/*.js": ["./extensions/drafts/client/*.ts"], "/x/policies/*.js": ["./extensions/policies/client/*.ts"], "/x/passages/*.js": ["./extensions/passages/client/*.ts"], "/x/quota/*.js": ["./extensions/quota/client/*.ts"], "/x/reviews/*.js": ["./extensions/reviews/client/*.ts"], "/lib/*.js": ["./src/lib/*.ts"], "/*.js": ["./src/shared/*.ts"] }
  },
  "include": ["src/tower/client.d.ts", "src/tower/tower.js", "src/tower/frame-keys.js", "renderers/week/week.js", "src/mod/hooks/register.js"]
}
