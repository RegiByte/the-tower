{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2024", "dom", "dom.iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": true,
    "paths": { "/x/drafts/*.js": ["./extensions/drafts/client/*.ts"], "/*.js": ["./src/shared/*.ts"], "/policies.js": ["./extensions/policies/client/policies.ts"] }
  },
  "include": ["src/tower/client.d.ts", "src/tower/tower.js", "renderers/week/week.js", "src/mod/hooks/register.js"]
}
