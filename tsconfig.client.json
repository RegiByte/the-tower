{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2024", "dom", "dom.iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": true,
    "paths": { "/*.js": ["./src/shared/*.ts"] }
  },
  "include": ["src/tower/client.d.ts", "src/tower/tower.js", "renderers/week/week.js"]
}
